# ============ 跟踪源（可选，缺失则读 config/channels.json） ============
CHANNELS={"文昭 Wen Zhao 频道": ["https://www.youtube.com/@wenzhaoofficial/videos"], "单视频 IKJzTovGaBE": ["https://www.youtube.com/watch?v=IKJzTovGaBE"]}

# ============ Email（QQ 邮箱） ============
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 必须为完整邮箱（QQ 号需带 @qq.com）；SMTP 信封发件人即此账号
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的QQ邮箱授权码（非登录密码）
MAIL_TO=收件人邮箱@example.com
# QQ 要求发件人须与登录账号一致，MAIL_FROM 建议保持默认（=SMTP_USER）
# MAIL_FROM=可省略，默认=SMTP_USER

# ============ 通知（可选，配置了才推送） ============
DINGTALK_WEBHOOK=
SERVERCHAN_KEY=

# ============ 其他（可选） ============
# COOKIES=Netscape 格式 cookie（部分视频需登录态）
#   获取：浏览器插件导出 Netscape 格式；或本机运行
#   yt-dlp --cookies-from-browser chrome --cookies - <视频URL> 得到文本
#   存为 GitHub Secret 时建议 base64 编码（shell 环境变量无法原样存多行）
# 注意：GitHub Secret 多行值需编码；脚本已支持 COOKIES 直接多行字符串