# ============ 跟踪源（可选，缺失则读 config/channels.json） ============
CHANNELS={"文昭 Wen Zhao 频道": ["https://www.youtube.com/@wenzhaoofficial/videos"], "单视频 IKJzTovGaBE": ["https://www.youtube.com/watch?v=IKJzTovGaBE"]}

# ============ Email（QQ 邮箱） ============
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的QQ邮箱授权码（非登录密码）
MAIL_TO=收件人邮箱@example.com
# MAIL_FROM=可省略，默认=SMTP_USER

# ============ 通知（可选，配置了才推送） ============
DINGTALK_WEBHOOK=
SERVERCHAN_KEY=

# ============ 其他（可选） ============
# COOKIES=Netscape 格式 cookie（部分视频需登录态）